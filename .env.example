# ── Afritop — production environment variables ─────────────────
# Copy these into Vercel → Project → Settings → Environment Variables.
# Everything marked optional can be left unset — the app degrades gracefully.

# ── Required: cloud transaction history + live deliveries chart ──
# Create a free Upstash Redis database, then copy its REST URL + token.
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Required: wallet sign-in sessions ───────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Protects the
# wallet-signature session cookie in production.
AUTH_SECRET=

# ── Payments ────────────────────────────────────────────────────
# USDC receiver address. LEAVE UNSET → demo mode (Arc testnet only,
# payments go to a burn address). Set to your own EVM address to go live.
USDC_RECEIVER=

# Circle hosted checkout (optional — wallet payments work without it).
CIRCLE_API_KEY=
CIRCLE_ENV=sandbox
CIRCLE_WEBHOOK_SECRET=

# ── Africa's Talking (real airtime delivery) ────────────────────
# Optional — without a key, airtime delivery is simulated end-to-end.
AT_API_KEY=
AT_USERNAME=sandbox
AT_ENV=sandbox

# ── Support chat → email (optional — chat works without it) ─────
RESEND_API_KEY=
SUPPORT_EMAIL=
SUPPORT_EMAIL_FROM=
SUPPORT_INBOUND_SECRET=
SUPPORT_INBOUND_DOMAIN=

# ── Site origin (optional — derived from request headers) ───────
# Set once you have a custom domain, e.g. https://afritop.xyz
NEXT_PUBLIC_APP_URL=
