# ── Afritop — production environment variables ─────────────────
# Copy these into Vercel → Project → Settings → Environment Variables.
#
# Afritop settles REAL USDC on Arc mainnet (chain ID 5042). Every path below
# fails closed: if a required value is missing we refuse the order rather than
# taking money we can't deliver against.

# ── REQUIRED — where customer USDC lands ───────────────────────
# A 42-character EVM address you control (0x…). Use a dedicated ops/treasury
# wallet, not a personal one. While this is unset the app serves no payable
# orders at all — it will not fall back to any placeholder address.
USDC_RECEIVER=0x2EdBe6602e8caE94ff9d3f7013Ddf78442813a5f

# ── REQUIRED — durable store + replay protection ───────────────
# Orders live here, and the one-transaction-per-order replay guard reads from
# this store. The serverless filesystem is ephemeral, so without Redis a
# consumed txHash can be forgotten and replayed. A real database is not
# optional for a payment system. https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── REQUIRED — wallet sign-in sessions ─────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Signs the
# wallet-signature session cookie.
AUTH_SECRET=

# ── Reloadly — airtime + data for every country (PRIMARY) ──────
# One integration covers airtime and data in NG, GH, KE and ZA. Self-serve
# credentials from https://dashboard.reloadly.com. RELOADLY_ENV must be "live"
# in production — anything else uses the sandbox, which issues FAKE top-ups.
# Operator / bundle ids come from your account (see lib/vendors/codes.ts).
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_ENV=live
# JSON, keyed "COUNTRY:networkId" → airtime operator id
# RELOADLY_OPERATOR_IDS={"NG:mtn":341}
# JSON, keyed by catalog bundle id → data bundle operator
# RELOADLY_BUNDLES={"ng-mtn-1gb":{"operatorId":341,"amount":500}}

# ── VTPass — Nigerian prepaid electricity ──────────────────────
# Returns the meter token synchronously. VTPass debits YOUR prefunded VTPass
# wallet, not the customer — keep it funded or vending fails. VTPASS_ENV must be
# "live" in production. VTPASS_FALLBACK_PHONE is the contact number VTPass
# requires on a vend (we don't collect a phone for meters).
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_ENV=live
VTPASS_FALLBACK_PHONE=
VTPASS_ELECTRICITY_TYPE=prepaid
# JSON: {"electricity:ikeja":"ikeja-electric","electricity:eko":"eko-electric"}
# VTPASS_SERVICE_IDS={}

# ── Hubtel — removed ───────────────────────────────────────────
# Ghana electricity is not offered: Hubtel never documents where the prepaid
# meter token is returned, and Reloadly's bill payment API returns no token at
# all. Ghana, Kenya and South Africa electricity stay on the labelled simulated
# pipeline. Nigerian prepaid electricity runs through VTPass above.

# ── Africa's Talking — TEMPORARY airtime fallback ──────────────
# Only here so live airtime keeps working until Reloadly is configured. Once
# Reloadly credentials are live, delete these and lib/africastalking.ts — the
# goal is Reloadly as the single telco partner. Without any airtime vendor,
# top-ups are refused rather than credited as a simulation.
AT_API_KEY=
AT_USERNAME=afritop
AT_ENV=live

# ── Delivery safety ────────────────────────────────────────────
# "true" refuses any service that has no live vending partner, instead of
# falling back to the (clearly-labelled) simulated pipeline. Recommended before
# scaling real volume.
AFRITOP_REQUIRE_REAL_DELIVERY=false

# ── Circle hosted checkout — DEFERRED ──────────────────────────
# Not part of the mainnet launch. The wallet path is the single supported
# payment route, so leave these unset until Circle checkout is actually shipped.
# CIRCLE_ENV selects the API: "live" targets https://api.circle.com/v1, anything
# else (including unset) stays on the sandbox API — so a half-configured
# deployment can never reach Circle production by accident.
CIRCLE_API_KEY=
CIRCLE_ENV=sandbox
CIRCLE_WEBHOOK_SECRET=

# ── Site origin (optional — derived from request headers) ──────
# Set once you have a custom domain, e.g. https://afritop.xyz
NEXT_PUBLIC_APP_URL=
